# Full Worker Dockerfile
# Image size: ~4-8GB (includes torch, TTS, ffmpeg)

FROM python:3.10-slim

WORKDIR /app

# Install system dependencies including ffmpeg for audio processing
RUN apt-get update && apt-get install -y \
    ffmpeg \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy worker-specific requirements
COPY requirements-worker.txt .
RUN pip install --no-cache-dir -r requirements-worker.txt

# Download NLTK data at build time
RUN python -c "import nltk; nltk.download('punkt'); nltk.download('punkt_tab'); nltk.download('averaged_perceptron_tagger')"

# Copy source code
COPY src/ ./src/

# Create audiobooks directory for shared volume
RUN mkdir -p audiobooks

# Run the Celery worker
# --concurrency: number of parallel tasks (adjust based on CPU/RAM)
# --prefetch-multiplier=1: fetch one task at a time for memory-heavy tasks
CMD ["celery", "-A", "src.worker.tasks", "worker", "--loglevel=info", "--concurrency=1", "--prefetch-multiplier=1", "-Q", "audiobook_tasks"]
